{
  "name": "project-guardian-mcp",
  "version": "3.0.0",
  "description": "Project Guardian MCP - A focused Model Context Protocol server for project memory management and workflow guardianship with knowledge graph capabilities",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:prod": "node scripts/build-prod.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:ci": "node scripts/run-tests.mjs --coverage --maxWorkers=2",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --max-warnings=0",
    "prepublishOnly": "npm run clean && npm run build:prod"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "project-guardian",
    "memory-management",
    "knowledge-graph",
    "project-management",
    "workflow-guardian",
    "sqlite",
    "knowledge-base"
  ],
  "author": "Hela-Ecosystem",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "redis": "^4.7.1",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.7"
  }
}
